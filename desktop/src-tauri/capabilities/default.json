{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "organiza-web",
  "description": "La Organiza publicada puede pedirle a la app: avisos nativos, modo focus encima y abrir la ventana.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://app-organiza-six.vercel.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-notify",
    "allow-focus-mode",
    "allow-bring-to-front",
    "allow-yt-open",
    "allow-yt-cmd",
    "allow-yt-show",
    "allow-yt-close"
  ]
}